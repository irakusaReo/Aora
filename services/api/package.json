{
  "name": "@aora/api",
  "version": "0.0.0",
  "private": true,
  "description": "AORA API and worker (sandbox only)",
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env.local dist/main.js",
    "start:worker": "node --env-file-if-exists=../../.env.local dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "prisma migrate deploy",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate",
    "db:seed": "node --env-file-if-exists=../../.env.local dist/seed.js",
    "neon:bootstrap": "node --env-file-if-exists=../../.env.local scripts/neon-bootstrap.mjs",
    "neon:verify": "node --env-file-if-exists=../../.env.local scripts/neon-verify.mjs",
    "ops:grant-operator": "node --env-file-if-exists=../../.env.local scripts/grant-operator.mjs",
    "secrets:generate": "node scripts/generate-secrets.mjs",
    "db:migrate:env": "node --env-file-if-exists=../../.env.local scripts/migrate-env.mjs",
    "db:seed:demo": "node --env-file-if-exists=../../.env.local scripts/seed-demo-env.mjs",
    "gate:check": "node --env-file-if-exists=../../.env.local scripts/gate-check-env.mjs"
  },
  "dependencies": {
    "@clerk/backend": "3.23.2",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vercel/blob": "2.8.0",
    "@vercel/functions": "3.9.11",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "svix": "2.8.0",
    "viem": "2.57.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "fast-check": "4.10.2",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "yaml": "2.9.1"
  }
}
