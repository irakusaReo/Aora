  onboarding_application_onboarding_application_decided_byTouser_account           onboarding_application[]   @relation("onboarding_application_decided_byTouser_account")
  consent_record                                                                   consent_record[]
  api_key_api_key_created_byTouser_account                                         api_key[]                  @relation("api_key_created_byTouser_account")
  api_key_api_key_revoked_byTouser_account                                         api_key[]                  @relation("api_key_revoked_byTouser_account")
  webhook_endpoint                                                                 webhook_endpoint[]
  step_up                                                                          step_up[]
  person                                                                           person                     @relation(fields: [person_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  layaway_instalment                                                               layaway_instalment[]
  layaway_refund                                                                   layaway_refund[]
  listing_plan_offer                                                               listing_plan_offer[]
  moderation_decision                                                              moderation_decision[]
  provisioning                                                                     provisioning[]
  purchase                                                                         purchase[]
  purchase_event                                                                   purchase_event[]
  quote_quote_consumer_account_idTouser_account                                    quote[]                    @relation("quote_consumer_account_idTouser_account")
  quote_quote_created_byTouser_account                                             quote[]                    @relation("quote_created_byTouser_account")
  quote_request                                                                    quote_request[]
  store_store_applicant_account_idTouser_account                                   store[]                    @relation("store_applicant_account_idTouser_account")
  store_store_decided_byTouser_account                                             store[]                    @relation("store_decided_byTouser_account")
  notification                                                                     notification[]
  payment_intent                                                                   payment_intent[]
  payout                                                                           payout[]
  payout_recipient_payout_recipient_confirmed_byTouser_account                     payout_recipient[]         @relation("payout_recipient_confirmed_byTouser_account")
  payout_recipient_payout_recipient_created_byTouser_account                       payout_recipient[]         @relation("payout_recipient_created_byTouser_account")
  reconciliation_exception                                                         reconciliation_exception[]
  refund                                                                           refund[]
  invitation_invitation_accepted_byTouser_account                                  invitation[]               @relation("invitation_accepted_byTouser_account")
  invitation_invitation_invited_byTouser_account                                   invitation[]               @relation("invitation_invited_byTouser_account")
  membership                                                                       membership[]
  workspace_restriction                                                            workspace_restriction[]

  @@schema("identity")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model membership {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String       @db.Uuid
  account_id   String       @db.Uuid
  role         String
  mode         String       @default("sandbox")
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  status       String       @default("active")
  branch_id    String?      @db.Uuid
  user_account user_account @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch       branch?      @relation(fields: [branch_id, tenant_id], references: [id, tenant_id], onDelete: NoAction, onUpdate: NoAction, map: "membership_branch_same_workspace")
  workspace    workspace    @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenant_id, account_id])
  @@schema("tenancy")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
