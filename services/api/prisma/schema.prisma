  webhook_event                             developer_webhook_event[]
  listing                                   listing[]
  provisioning                              provisioning[]
  store_store_existing_tenant_idToworkspace store[]                     @relation("store_existing_tenant_idToworkspace")
  store_store_tenant_idToworkspace          store?                      @relation("store_tenant_idToworkspace")
  account                                   account[]
  account_balance                           account_balance[]
  journal_entry                             journal_entry[]
  posting                                   posting[]
  notification                              notification[]
  outbox_event                              outbox_event[]
  operation_transition                      operation_transition[]
  payment_intent                            payment_intent[]
  payment_intent_transition                 payment_intent_transition[]
  payout                                    payout[]
  payout_recipient                          payout_recipient[]
  provider_operation                        provider_operation[]
  reconciliation_exception                  reconciliation_exception[]
  refund                                    refund[]
  settlement_batch                          settlement_batch[]
  branch                                    branch[]
  invitation                                invitation[]
  membership                                membership[]
  business                                  business                    @relation(fields: [business_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
