generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["audit", "business", "consent", "identity", "ledger", "notifications", "ops", "outbox", "payments", "pricing", "sim", "tenancy"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_event {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurred_at      DateTime      @default(now()) @db.Timestamptz(6)
  tenant_id        String?       @db.Uuid
  actor_kind       String
  actor_account_id String?       @db.Uuid
  action           String
  subject_type     String
  subject_id       String
  outcome          String
  request_id       String?
  detail           Json          @default("{}")
  mode             String        @default("sandbox")
  user_account     user_account? @relation(fields: [actor_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspace        workspace?    @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenant_id, occurred_at], map: "audit_event_tenant_time")
  @@schema("audit")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model business {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind                String
  name                String
  name_normalised     String
  country             String
  owner_person_id     String?               @db.Uuid
  location            Json?
  location_key        String?
  mode                String                @default("sandbox")
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  person              person?               @relation(fields: [owner_person_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  business_identifier business_identifier[]
  workspace           workspace[]

  @@unique([owner_person_id, name_normalised, location_key], map: "business_unregistered_identity", where: raw("(kind = 'unregistered'::text)"))
  @@schema("business")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model business_identifier {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id      String    @db.Uuid
  type             String
  country          String
  value_normalised String
  verified_at      DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  business         business  @relation(fields: [business_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([type, country, value_normalised])
  @@schema("business")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model auth_challenge {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id   String       @db.Uuid
  purpose      String
  code_hash    String
  attempts     Int          @default(0)
  expires_at   DateTime     @db.Timestamptz(6)
  consumed_at  DateTime?    @db.Timestamptz(6)
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  user_account user_account @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("identity")
}

model person {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  business       business[]
  consent_record consent_record[]
  user_account   user_account[]

  @@schema("identity")
}

model session {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id    String       @db.Uuid
  token_hash    String       @unique
  expires_at    DateTime     @db.Timestamptz(6)
  revoked_at    DateTime?    @db.Timestamptz(6)
  step_up_until DateTime?    @db.Timestamptz(6)
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  user_account  user_account @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("identity")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model user_account {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  person_id            String           @db.Uuid
  phone_e164           String?          @unique
  is_platform_operator Boolean          @default(false)
  mode                 String           @default("sandbox")
  created_at           DateTime         @default(now()) @db.Timestamptz(6)
  pin_hash             String?
  pin_set_at           DateTime?        @db.Timestamptz(6)
  pin_failed_attempts  Int              @default(0)
  pin_locked_until     DateTime?        @db.Timestamptz(6)
  clerk_user_id        String?          @unique
  email                String?
  display_name         String?
  phone_verified_at    DateTime?        @db.Timestamptz(6)
  status               String           @default("active")
  closed_at            DateTime?        @db.Timestamptz(6)
  provider_updated_at  BigInt           @default(0)
  audit_event          audit_event[]
  consent_record       consent_record[]
  auth_challenge       auth_challenge[]
  session              session[]
  step_up              step_up[]
  person               person           @relation(fields: [person_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  notification         notification[]
  payment_intent       payment_intent[]
  membership           membership[]

  @@schema("identity")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model membership {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String       @db.Uuid
  account_id   String       @db.Uuid
  role         String
  mode         String       @default("sandbox")
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  status       String       @default("active")
  branch_id    String?      @db.Uuid
  user_account user_account @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch       branch?      @relation(fields: [branch_id, tenant_id], references: [id, tenant_id], onDelete: NoAction, onUpdate: NoAction, map: "membership_branch_same_workspace")
  workspace    workspace    @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenant_id, account_id])
  @@schema("tenancy")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model workspace {
  id                        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id               String                      @db.Uuid
  product                   String
  mode                      String                      @default("sandbox")
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  tier                      String                      @default("tier_0")
  audit_event               audit_event[]
  consent_record            consent_record[]
  account                   account[]
  account_balance           account_balance[]
  journal_entry             journal_entry[]
  posting                   posting[]
  notification              notification[]
  outbox_event              outbox_event[]
  payment_intent            payment_intent[]
  payment_intent_transition payment_intent_transition[]
  reconciliation_exception  reconciliation_exception[]
  branch                    branch[]
  membership                membership[]
  business                  business                    @relation(fields: [business_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([business_id, product])
  @@schema("tenancy")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model account {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String?          @db.Uuid
  asset_code      String
  type            String
  qualifier       String           @default("")
  normal_side     String
  allow_negative  Boolean          @default(false)
  mode            String           @default("sandbox")
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  asset           asset            @relation(fields: [asset_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  workspace       workspace?       @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  account_balance account_balance?
  posting         posting[]

  @@unique([type, qualifier, asset_code], map: "account_platform_unique", where: raw("(tenant_id IS NULL)"))
  @@unique([tenant_id, type, qualifier, asset_code], map: "account_tenant_unique", where: raw("(tenant_id IS NOT NULL)"))
  @@schema("ledger")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
