model journal_entry {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String?        @db.Uuid
  idempotency_key     String         @unique
  entry_type          String
  operation_type      String
  operation_id        String
  reverses_entry_id   String?        @unique @db.Uuid
  mode                String         @default("sandbox")
  posted_at           DateTime       @default(now()) @db.Timestamptz(6)
  created_txid        BigInt         @default(dbgenerated("txid_current()"))
  journal_entry       journal_entry? @relation("journal_entryTojournal_entry", fields: [reverses_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_journal_entry journal_entry? @relation("journal_entryTojournal_entry")
  workspace           workspace?     @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  posting             posting[]

  @@index([operation_type, operation_id], map: "journal_entry_operation")
  @@schema("ledger")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
