model payment_intent {
  id                        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                 String                      @db.Uuid
  idempotency_key           String
  request_hash              String
  amount                    BigInt
  asset_code                String
  status                    String                      @default("created")
  provider                  String
  provider_reference        String?
  sandbox_scenario          String?
  failure_code              String?
  status_inquiries          Int                         @default(0)
  created_by                String                      @db.Uuid
  mode                      String                      @default("sandbox")
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                    @default(now()) @db.Timestamptz(6)
  rail                      String                      @default("simulator")
  fee_amount                BigInt                      @default(0)
  tariff_version_id         String?                     @db.Uuid
  branch_id                 String?                     @db.Uuid
  reference                 String?
  net_amount                BigInt?                     @default(dbgenerated("(amount - fee_amount)"))
  settlement_batch_id       String?                     @db.Uuid
  purpose                   String                      @default("collection")
  layaway_instalment        layaway_instalment?
  asset                     asset                       @relation(fields: [asset_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  branch                    branch?                     @relation(fields: [branch_id, tenant_id], references: [id, tenant_id], onDelete: NoAction, onUpdate: NoAction, map: "payment_intent_branch_same_workspace")
  user_account              user_account                @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  settlement_batch          settlement_batch?           @relation(fields: [settlement_batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tariff_version            tariff_version?             @relation(fields: [tariff_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspace                 workspace                   @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment_intent_transition payment_intent_transition[]
  refund                    refund[]

  @@unique([tenant_id, idempotency_key])
  @@index([status, updated_at], map: "payment_intent_status")
  @@index([tenant_id, created_at(sort: Desc), id], map: "payment_intent_tenant_created")
  @@schema("payments")
}

