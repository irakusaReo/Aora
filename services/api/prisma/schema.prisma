generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["audit", "business", "chain", "chiwo", "consent", "developer", "identity", "kelo", "ledger", "nam", "notifications", "ops", "outbox", "payments", "pricing", "sim", "tenancy"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_event {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurred_at      DateTime      @default(now()) @db.Timestamptz(6)
  tenant_id        String?       @db.Uuid
  actor_kind       String
  actor_account_id String?       @db.Uuid
  action           String
  subject_type     String
  subject_id       String
  outcome          String
  request_id       String?
  detail           Json          @default("{}")
  mode             String        @default("sandbox")
  user_account     user_account? @relation(fields: [actor_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspace        workspace?    @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenant_id, occurred_at], map: "audit_event_tenant_time")
  @@schema("audit")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model business {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind                   String
  name                   String
  name_normalised        String
  country                String
  owner_person_id        String?                  @db.Uuid
  location               Json?
  location_key           String?
  mode                   String                   @default("sandbox")
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  person                 person?                  @relation(fields: [owner_person_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  business_identifier    business_identifier[]
  match_decision         match_decision[]
  onboarding_application onboarding_application[]
  provisioning           provisioning[]
  store                  store[]
  workspace              workspace[]

  @@unique([owner_person_id, name_normalised, location_key], map: "business_unregistered_identity", where: raw("(kind = 'unregistered'::text)"))
  @@schema("business")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model business_identifier {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id      String    @db.Uuid
  type             String
  country          String
  value_normalised String
  verified_at      DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  business         business  @relation(fields: [business_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([type, country, value_normalised])
  @@schema("business")
}

model person {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  business         business[]
  consent_record   consent_record[]
  user_account     user_account[]
  investor_profile investor_profile?

  @@schema("identity")
}

