model outbox_event {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String?    @db.Uuid
  type         String
  payload      Json       @default("{}")
  status       String     @default("pending")
  attempts     Int        @default(0)
  available_at DateTime   @default(now()) @db.Timestamptz(6)
  locked_at    DateTime?  @db.Timestamptz(6)
  last_error   String?
  mode         String     @default("sandbox")
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  processed_at DateTime?  @db.Timestamptz(6)
  workspace    workspace? @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([available_at, created_at], map: "outbox_event_due", where: raw("(status = 'pending'::text)"))
  @@index([locked_at], map: "outbox_event_processing", where: raw("(status = 'processing'::text)"))
  @@schema("outbox")
}

