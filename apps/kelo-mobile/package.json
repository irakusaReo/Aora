  "dependencies": {
    "@aora/api-client": "workspace:*",
    "@aora/mobile": "workspace:*",
    "@aora/ui": "workspace:*",
    "@clerk/expo": "4.13.0",
    "@expo/metro-runtime": "58.0.14",
    "expo": "58.0.16",
    "expo-auth-session": "58.0.13",
    "expo-constants": "58.0.12",
    "expo-crypto": "58.0.7",
    "expo-linking": "58.0.13",
    "expo-router": "58.0.24",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.3",
    "expo-web-browser": "58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "jsdom": "30.1.3",
    "react-dom": "19.3.0",
    "react-native-web": "0.21.4"
  }
