{
  "name": "kelo-mobile",
  "version": "0.0.0",
  "private": true,
  "description": "KELO marketplace app for Android and iOS (Expo, sandbox only)",
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "export": "expo export --platform android --output-dir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json"
