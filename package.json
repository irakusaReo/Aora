{
  "name": "aora",
  "version": "0.0.0",
  "private": true,
  "description": "AORA platform monorepo (sandbox only)",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r build",
    "db:start": "./scripts/dev-db.sh start",
    "db:stop": "./scripts/dev-db.sh stop",
    "db:reset": "./scripts/dev-db.sh reset",
    "db:migrate": "pnpm -r db:migrate",
    "db:generate": "pnpm -r db:generate",
    "postinstall": "pnpm -r db:generate",
    "start:api": "pnpm --filter @aora/api start",
    "start:worker": "pnpm --filter @aora/api start:worker",
    "db:seed": "pnpm --filter @aora/api db:seed",
    "neon:bootstrap": "pnpm --filter @aora/api neon:bootstrap",
    "secrets:generate": "pnpm --filter @aora/api secrets:generate",
    "neon:verify": "pnpm --filter @aora/api neon:verify",
    "db:migrate:staging": "pnpm --filter @aora/api db:migrate:env staging",
    "db:migrate:development": "pnpm --filter @aora/api db:migrate:env development"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.4"
  }
}
