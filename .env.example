# AORA environment — PLACEHOLDERS ONLY.
# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# Never put private keys, seed phrases or provider API keys in any env file
# that is committed, logged or stored in the database (CLAUDE.md rule 9).

# Phase 0–12 run in sandbox only. No other value is accepted.
AORA_MODE=sandbox

# PostgreSQL connection for local development (used from Phase 1).
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<database>
