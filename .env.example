# AORA environment — PLACEHOLDERS ONLY.
# Copy to .env.local (git-ignored) and fill in locally. Never commit real values.
# Never put private keys, seed phrases or provider API keys in any file that is
# committed, logged or stored in the database (CLAUDE.md rule 9).

# Sandbox is the only mode. The API and worker refuse to start with any other value.
AORA_MODE=sandbox

# PostgreSQL. Three roles (see services/api/prisma/bootstrap.sql):
#   owner     runs migrations only
#   app       API requests for a signed-in user; tenant rows only (row-level security)
#   platform  worker, webhook intake, reconciliation, operator endpoints
# The values below match the local throwaway cluster started by `pnpm db:start`,
# which uses trust authentication and needs no password.
DATABASE_URL_OWNER=postgresql://aora_owner@127.0.0.1:54329/aora_dev
DATABASE_URL_APP=postgresql://aora_app@127.0.0.1:54329/aora_dev
DATABASE_URL_PLATFORM=postgresql://aora_platform@127.0.0.1:54329/aora_dev

# Signs webhooks from the AORA simulator provider. Generate locally:
#   openssl rand -hex 32
SANDBOX_SIM_WEBHOOK_SECRET=<generate-locally>

# Server-side pepper for transaction PIN hashes. Generate locally:
#   openssl rand -hex 32
PIN_PEPPER=<generate-locally>

# Who authenticates requests.
#   clerk    Clerk session tokens (the default, and the only choice on a deployed environment)
#   sandbox  TESTS AND LOCAL WORK ONLY: tokens minted in-process. Refused unless the process
#            is on a developer machine and both databases above are local.
AUTH_PROVIDER=sandbox

# Clerk DEVELOPMENT instance (docs/operations/clerk-setup.md). Test keys only:
# a key starting pk_live_ or sk_live_ is refused.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# PEM public key of the instance, on one line with \n between lines, in double quotes.
CLERK_JWT_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# Comma-separated origins allowed to mint session tokens for this API. Required when deployed.
CLERK_AUTHORIZED_PARTIES=

# Resend (docs/operations/resend-setup.md). Leave empty locally to use the simulated email channel.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=AORA Sandbox <onboarding@resend.dev>

# Authenticates scheduler-triggered jobs. Required on deployed environments.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Safaricom Daraja SANDBOX (docs/providers/daraja.md). Sandbox app and test data only.
# --- Leave empty to use the AORA simulator for the mpesa rail.
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_B2C_SHORTCODE=
DARAJA_INITIATOR_NAME=
DARAJA_INITIATOR_PASSWORD=
# Non-secret sandbox test values from the Daraja simulator page.
DARAJA_TEST_PARTY_B=
DARAJA_TEST_MSISDN=
# Must be the Daraja sandbox (the API refuses anything else). Defaults to it.
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
# Optional comma-separated callback source addresses; empty = not enforced (ADR 0022).
DARAJA_CALLBACK_ALLOWED_IPS=
# AORA-owned. Generate both with: pnpm secrets:generate
DARAJA_CALLBACK_SECRET=
WEBHOOK_SIGNING_PRIVATE_KEY=

# Vercel Blob store for KELO listing images (public store `aora-sandbox-images`,
# fra1; docs/providers/vercel-blob.md). Needed by aora-api only. Empty = the
# image simulator. BLOB_STORE_ID is informational; the code does not read it.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Base Sepolia (testnet only; docs/providers/base-sepolia.md). Empty RPC URL =
# every chain feature off. Base's public endpoint is rate-limited and fine for
# development; a second, private provider is on the pre-pilot list.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# The sandbox development signer (ADR 0009 interim): a TESTNET-ONLY key. Create
# it with `node services/api/scripts/generate-sandbox-signer.mjs`, which writes
# it here and prints only the address. Never a key that has held mainnet funds.
SANDBOX_SIGNER_PRIVATE_KEY=
# Optional: the block a new inbound-scan cursor starts from, before the wallet's
# first deposit (faucet funding sent before the chain was switched on is then
# still observed). Empty: start near the current head.
BASE_SEPOLIA_SCAN_START_BLOCK=

# Where the API listens, and where the worker delivers simulator webhooks.
PORT=3000
PUBLIC_API_URL=http://127.0.0.1:3000

# --- Web apps (apps/kony-web, apps/internal-ops). Next.js reads these from a
# --- .env.local inside each app's own folder when run locally.
# Where the apps reach the API, server side only.
AORA_API_URL=http://127.0.0.1:3000
# The same Clerk development instance as the API. The publishable key is public by design.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Neon (docs/operations/neon-setup.md). Direct connection strings of the
# --- project's default role; used only by `pnpm neon:bootstrap`, never deployed.
NEON_ADMIN_URL_STAGING=
NEON_ADMIN_URL_DEVELOPMENT=
