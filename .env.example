# AORA environment — PLACEHOLDERS ONLY.
# Copy to .env.local (git-ignored) and fill in locally. Never commit real values.
# Never put private keys, seed phrases or provider API keys in any file that is
# committed, logged or stored in the database (CLAUDE.md rule 9).

# Sandbox is the only mode. The API and worker refuse to start with any other value.
AORA_MODE=sandbox

# PostgreSQL. Three roles (see services/api/prisma/bootstrap.sql):
#   owner     runs migrations only
#   app       API requests for a signed-in user; tenant rows only (row-level security)
#   platform  worker, webhook intake, reconciliation, operator endpoints
# The values below match the local throwaway cluster started by `pnpm db:start`,
# which uses trust authentication and needs no password.
DATABASE_URL_OWNER=postgresql://aora_owner@127.0.0.1:54329/aora_dev
DATABASE_URL_APP=postgresql://aora_app@127.0.0.1:54329/aora_dev
DATABASE_URL_PLATFORM=postgresql://aora_platform@127.0.0.1:54329/aora_dev

# Signs webhooks from the AORA simulator provider. Generate locally:
#   openssl rand -hex 32
SANDBOX_SIM_WEBHOOK_SECRET=<generate-locally>

# Where the API listens, and where the worker delivers simulator webhooks.
PORT=3000
PUBLIC_API_URL=http://127.0.0.1:3000
